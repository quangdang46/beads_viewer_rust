  "environment_variables": {
    "BEADS_DB": "Path to beads database file or .beads directory (overrides BEADS_DIR; overridden by --db flag)",
    "BEADS_DIR": "Path to .beads directory (fallback when BEADS_DB and --db are not set)",
    "BV_OUTPUT_FORMAT": "Default output format: json or toon (overridden by --format)",
    "BV_PRETTY_JSON": "Set to 1 for indented JSON output",
    "BV_ROBOT": "Set to 1 to force robot mode (clean stdout)",
    "BV_SEARCH_MODE": "Search mode: text or hybrid",
    "BV_SEARCH_PRESET": "Hybrid search preset name",
    "TOON_DEFAULT_FORMAT": "Fallback format if BV_OUTPUT_FORMAT not set",
    "TOON_INDENT": "TOON indentation level (0-16)",
    "TOON_KEY_FOLDING": "TOON key folding mode",
    "TOON_STATS": "Set to 1 to show JSON vs TOON token estimates on stderr"
  },
  "examples": [
    {
      "command": "bv robot-triage --json | jq '.triage.quick_ref.top_picks[:3]'",
      "description": "Get top 3 picks for immediate work"
    },
    {
      "command": "bv robot-next --json | jq -r '.claim_command'",
      "description": "Inspect the claim command for the top recommendation"
    },
    {
      "command": "bv robot-triage --json | jq '.triage.blockers_to_clear | map(.id)'",
      "description": "Find high-impact blockers to clear"
    },
    {
      "command": "bv robot-triage --json | jq '.triage.recommendations[] | select(.type == \"bug\")'",
      "description": "Get bug-only recommendations"
    },
    {
      "command": "bv robot-triage-by-track --json | jq '.triage.recommendations_by_track[].top_pick'",
      "description": "Multi-agent: top pick per parallel track"
    },
    {
      "command": "bv robot-file-beads README.md --json",
      "description": "Find beads related to a specific file"
    },
    {
      "command": "bv robot-search \"authentication\" --json",
      "description": "Search for issues by keyword"
    },
    {
      "command": "bv robot-graph --toon",
      "description": "Get TOON output for a wide payload (measured ~7% smaller than JSON)"
    },
    {
      "command": "BV_OUTPUT_FORMAT=toon bv robot-triage",
      "description": "Use env for default format"
    },
    {
      "command": "TOON_STATS=1 bv robot-triage --toon",
      "description": "Compare JSON and TOON size for this payload (TOON can be larger)"
    }
  ],
  "exit_codes": {
